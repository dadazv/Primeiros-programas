programa
{
	
	funcao inicio()
	{
		cadeia nome[4]
		
		para(inteiro i = 1;i <= 3;i ++){
			escreva("Digite o nome: \n")
			leia(nome[i])
		}
		para(inteiro y = 1;y <= 3;y ++){
			escreva(y," nome: ",nome[y],"\n")
		}
	}
}
