programa {
  funcao inicio(){
    real num1,num2

    escreva("Digite um numero: \n")
    leia(num1)
    escreva("Digite outro numero: \n")
    leia(num2)

    escreva("Divisão: ",num1,"/",num2,"=",(num1 / num2),"\n")
    escreva("Adição: ",num1,"+",num2,"=",(num1 + num2),"\n")
    escreva("Subtração: ",num1,"-",num2,"=",(num1 - num2),"\n")
    escreva("Multiplicação: ",num1,"*",num2,"=",(num1 * num2),"\n")
  }
}
