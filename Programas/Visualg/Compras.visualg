algoritmo "Preço"
var
  prec:vetor[1..3] de inteiro
  prod:vetor[1..3] de inteiro
  total,qtd,opc:inteiro
inicio
  repita
    escreval("Escolha o produto: ")
    leia(opc)
    se(opc <> 0)entao
      escreval("Digite a quantidade: ")
      leia(qtd)

      prec[1] <- 10
      prec[2] <- 5 
      prec[3] <- 15

      prod[1] <- 1
      prod[2] <- 2
      prod[3] <- 3

      total <- total + (prec[opc] * qtd)

      escreval("Produto: ",prod[opc])
      escreval("Preco: ",prec[opc])
      escreval("Quantidade: ",qtd)
      escreval("Subtotal: ",prec[opc]* qtd)
      escreval("Total: ",total)
    fimse
  ate(opc = 0)
  escreval("Compra encerrada.")
fimalgoritmo